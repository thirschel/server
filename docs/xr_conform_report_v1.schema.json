{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xregistry.io/schemas/xr_conform_report_v1.schema.json",
  "title": "xr conform report version 1",
  "description": "Version 1.0.0 deterministic reports emitted by xr conform. Consumers should ignore unknown additive fields when reading compatible minor versions.",
  "oneOf": [
    {
      "$ref": "#/$defs/executionReport"
    },
    {
      "$ref": "#/$defs/catalogReport"
    }
  ],
  "$defs": {
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "buildVersion",
        "commit"
      ],
      "properties": {
        "name": {
          "const": "xr conform"
        },
        "buildVersion": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "specVersion",
        "specRepository",
        "specCommit",
        "specBaseURL"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "specVersion": {
          "type": "string",
          "minLength": 1
        },
        "specRepository": {
          "type": "string",
          "format": "uri"
        },
        "specCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "specBaseURL": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "specReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "path",
        "anchor",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "caseCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "warnings",
        "skipped",
        "notRun"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tdEntryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "pass",
        "fail",
        "warn",
        "skip"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnosticOutcome": {
      "enum": [
        "passed",
        "failed",
        "warning",
        "skipped",
        "dependency-not-run"
      ]
    },
    "diagnostic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "outcome"
          ],
          "properties": {
            "kind": {
              "const": "group"
            },
            "name": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/diagnosticOutcome"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "pass",
                "failure",
                "warning",
                "skip",
                "log",
                "message"
              ]
            },
            "message": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "caseOutcome": {
      "enum": [
        "passed",
        "failed",
        "warning",
        "skipped",
        "dependency-not-run"
      ]
    },
    "executionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "name",
        "description",
        "profile",
        "mode",
        "selection",
        "dependencies",
        "specReferences",
        "outcome",
        "diagnostics"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "read-only",
            "mutation"
          ]
        },
        "selection": {
          "enum": [
            "requested",
            "dependency-only"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockedByDependency": {
          "type": "string",
          "minLength": 1
        },
        "specReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specReference"
          }
        },
        "outcome": {
          "$ref": "#/$defs/caseOutcome"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedURL",
        "effectiveURL",
        "detectedSpecVersion",
        "profileMatch",
        "outcome",
        "cases"
      ],
      "properties": {
        "requestedURL": {
          "type": "string",
          "minLength": 1
        },
        "effectiveURL": {
          "type": "string",
          "minLength": 1
        },
        "detectedSpecVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileMatch": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/caseOutcome"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionCase"
          }
        }
      }
    },
    "executionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "schemaVersion",
        "runner",
        "profile",
        "invocation",
        "caseCounts",
        "targets"
      ],
      "properties": {
        "kind": {
          "const": "execution"
        },
        "schema": {
          "const": "https://xregistry.io/schemas/xr_conform_report_v1.schema.json"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedTestIDs",
            "resolvedTestIDs",
            "completeSelection",
            "output",
            "allowMutations"
          ],
          "properties": {
            "requestedTestIDs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resolvedTestIDs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completeSelection": {
              "type": "boolean"
            },
            "output": {
              "enum": [
                "json",
                "junit"
              ]
            },
            "allowMutations": {
              "type": "boolean"
            }
          }
        },
        "caseCounts": {
          "$ref": "#/$defs/caseCounts"
        },
        "tdEntryCounts": {
          "$ref": "#/$defs/tdEntryCounts"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "catalogCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "name",
        "description",
        "profile",
        "mode",
        "dependencies",
        "specReferences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "read-only",
            "mutation"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "specReferences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specReference"
          }
        }
      }
    },
    "catalogReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "schemaVersion",
        "runner",
        "profiles",
        "cases"
      ],
      "properties": {
        "kind": {
          "const": "catalog"
        },
        "schema": {
          "const": "https://xregistry.io/schemas/xr_conform_report_v1.schema.json"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "runner": {
          "$ref": "#/$defs/runner"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/catalogCase"
          }
        }
      }
    }
  }
}
